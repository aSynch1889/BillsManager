        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills Manager는 Face ID로 개인 청구 기록을 보호합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账单管家使用面容 ID 保护你的私人账单记录。"
