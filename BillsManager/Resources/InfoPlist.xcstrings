    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo library usage",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills Manager needs photo library access to attach receipt images to your bills."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills Manager は請求に領収書画像を添付するためフォトライブラリへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills Manager는 청구서에 영수증 이미지를 첨부하기 위해 사진 보관함에 접근합니다."
          }
