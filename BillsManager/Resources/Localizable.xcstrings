        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize utilities, subscriptions, rent, and card payments in one unified place with automatic recurring dates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水道・光熱費、サブスクリプション、家賃、カードの支払いを一か所で管理し、繰り返しの日付を自動記録します。"
          }
