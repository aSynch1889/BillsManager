    "100% local storage protected with Face ID. Export data to CSV or JSON backup anytime.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "100% local storage protected with Face ID. Export data to CSV or JSON backup anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100% ローカルストレージで Face ID で保護。データはいつでも CSV または JSON バックアップに書き出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 로컬 저장소이며 Face ID로 보호됩니다. 언제든 데이터를 CSV 또는 JSON 백업으로 내보낼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 本地存储，受 Face ID 保护。可随时将数据导出为 CSV 或 JSON 备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "100% 本地儲存，受 Face ID 保護。可隨時將資料匯出為 CSV 或 JSON 備份。"
          }
        }
      }
    },
