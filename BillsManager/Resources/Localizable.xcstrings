    "Bills stay on this device. Optional Face ID lock (PRO). Export CSV or JSON backup anytime." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bills stay on this device. Optional Face ID lock (PRO). Export CSV or JSON backup anytime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求データはこの端末のみに保存されます。任意の Face ID ロック（PRO）。CSV または JSON バックアップをいつでも書き出せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "청구 데이터는 이 기기에만 저장됩니다. Face ID 잠금(PRO) 선택 가능. CSV 또는 JSON 백업을 언제든 내보낼 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "账单仅保存在本机。可选 Face ID 锁（PRO）。随时导出 CSV 或 JSON 备份。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "帳單僅保存在本機。可選 Face ID 鎖（PRO）。隨時匯出 CSV 或 JSON 備份。"
          }
        }
      }
    },
