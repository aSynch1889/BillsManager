    "Payment will be charged to your Apple ID account at confirmation of purchase." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment will be charged to your Apple ID account at confirmation of purchase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入の確認時に、Apple ID のアカウントに課金されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구매 확인 시 Apple ID 계정으로 결제됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买确认后，款项将从您的 Apple ID 账户扣取。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購買確認後，款項將從您的 Apple ID 帳戶扣款。"
          }
        }
      }
    },
    "Payment will be charged to your Apple ID account at confirmation of purchase. This is a one-time Non-Consumable purchase that unlocks PRO permanently for this Apple ID." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payment will be charged to your Apple ID account at confirmation of purchase. This is a one-time Non-Consumable purchase that unlocks PRO permanently for this Apple ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "購入確認時に Apple ID アカウントへ請求されます。この Apple ID で PRO を永続解除する買い切り（非消耗型）です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구입 확인 시 Apple ID 계정으로 결제됩니다. 이 Apple ID에서 PRO를 영구 잠금 해제하는 일회성 비소모성 구입입니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确认购买后将从你的 Apple ID 账户扣款。这是一次性非消耗型购买，将为此 Apple ID 永久解锁 PRO。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認購買後將從你的 Apple ID 帳戶扣款。這是一次性非消耗型購買，將為此 Apple ID 永久解鎖 PRO。"
          }
        }
      }
    },
