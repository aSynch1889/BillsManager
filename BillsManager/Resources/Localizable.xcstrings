    "Organize utilities, subscriptions, rent, and card payments in one unified place with automatic recurring dates." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在统一的地方管理水电费、订阅、房租和信用卡还款，并自动记录周期性日期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在統一的地方管理水電費、訂閱、房租和信用卡還款，並自動記錄週期性日期。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水道・光熱費、サブスクリプション、家賃、カードの支払いを一か所で管理し、繰り返しの日付を自動記録します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
